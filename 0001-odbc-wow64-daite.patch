+static WCHAR *append_connect_string_attribute( WCHAR *str, const WCHAR *attribute )
+{
+    SIZE_T len = wcslen( str ), attr_len = wcslen( attribute );
+    BOOL separator = len && str[len - 1] != ';';
+    WCHAR *ret;
+
+    if (!(ret = realloc( str, (len + separator + attr_len + 1) * sizeof(*ret) ))) return NULL;
+    if (separator) ret[len++] = ';';
+    memcpy( ret + len, attribute, (attr_len + 1) * sizeof(*ret) );
+    return ret;
+}
