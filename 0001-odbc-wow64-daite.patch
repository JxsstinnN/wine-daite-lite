+static SQLRETURN store_connect_option( struct connection *con, SQLUSMALLINT option, SQLULEN value )
+{
+    switch (option)
+    {
+    case SQL_LOGIN_TIMEOUT:
+        con->attr_login_timeout = value;
+        con->login_timeout_set = TRUE;
+        break;
+    case SQL_PACKET_SIZE:
+        con->attr_packet_size = value;
+        con->packet_size_set = TRUE;
+        break;
+    case SQL_AUTOCOMMIT:
+        con->attr_autocommit = value;
+        con->autocommit_set = TRUE;
+        break;
+    case SQL_ODBC_CURSORS:
+        con->attr_odbc_cursors = value;
+        con->odbc_cursors_set = TRUE;
+        break;
+    default:
+        FIXME( "unhandled pre-connect option %u\n", option );
+        return SQL_ERROR;
+    }
+    return SQL_SUCCESS;
+}
